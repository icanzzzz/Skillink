{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noUncheckedIndexedAccess": true,
    "types": ["node", "vitest/globals"],
    "paths": {
      "@skillink/shared": ["./packages/shared/src/index.ts"],
      "@skillink/core": ["./packages/core/src/index.ts"],
      "@skillink/cli/run": ["./apps/cli/src/run.ts"],
      "@skillink/cli": ["./apps/cli/src/index.ts"]
    }
  },
  "include": [
    "packages/**/*.ts",
    "apps/**/*.ts",
    "apps/**/*.tsx",
    "vitest.config.ts",
    "tsup.config.ts"
  ]
}
