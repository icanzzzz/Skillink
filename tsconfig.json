{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noUncheckedIndexedAccess": true,
    "types": ["node", "vitest/globals"],
    "paths": {
      "@skillink/shared": ["./packages/shared/src/index.ts"],
      "@skillink/core": ["./packages/core/src/index.ts"]
    }
  },
  "include": ["packages/**/*.ts", "apps/**/*.ts", "vitest.config.ts", "tsup.config.ts"]
}
