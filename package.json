{
  "name": "skillink",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "pnpm build:cli && pnpm build:desktop",
    "build:cli": "tsup",
    "build:desktop": "pnpm --filter @skillink/desktop build",
    "package:desktop": "pnpm --filter @skillink/desktop package:dir",
    "package:win": "pnpm --filter @skillink/desktop package:win",
    "dev:cli": "tsx apps/cli/src/index.ts",
    "setup:electron": "node apps/desktop/node_modules/electron/install.js",
    "predev:desktop": "pnpm setup:electron",
    "dev:desktop": "pnpm --filter @skillink/desktop dev"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/semver": "^7.7.0",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
